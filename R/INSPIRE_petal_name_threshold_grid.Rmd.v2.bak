```{r setup, message=FALSE, warning=FALSE}
required_packages <- c(
  "DBI", "RSQLite", "dplyr", "tidyr", "readr", "stringr",
  "ggplot2", "igraph", "pheatmap", "patchwork"
)

missing_packages <- required_packages[
  !vapply(required_packages, requireNamespace, logical(1), quietly = TRUE)
]

if (length(missing_packages) > 0) {
  stop("Install missing R packages: ", paste(missing_packages, collapse = ", "))
}

library(DBI)
library(RSQLite)
library(dplyr)
library(tidyr)
library(readr)
library(stringr)
library(ggplot2)
library(igraph)
library(pheatmap)
library(patchwork)

set.seed(20260729)
dir.create(params$output_dir, recursive = TRUE, showWarnings = FALSE)
```

# Analysis definition

This report performs three separate petal-level comparisons:

1. **INSPIRE** compares the complete petal networks using the normalized C++ alignment result.
2. **GO petal-name comparison** compares only the gene represented by each petal name. For example, petal `PTEN` is compared with petal `SMAD2` using the cached GO score for gene `PTEN` versus gene `SMAD2`. No other genes or edges from either petal enter this GO comparison.
3. **Pfam petal-name comparison** compares only the Pfam-domain sets of the two genes represented by the two petal names. No other genes or edges enter this Pfam comparison.

INSPIRE clustering is explored over thresholds from `r params$threshold_min` through `r params$threshold_max`. At each threshold, the report computes:

- complete-linkage threshold clusters;
- connected components in the retained-edge graph;
- weighted Walktrap communities;
- number of retained edges, isolates, and cluster sizes;
- adjusted Rand agreement with the preceding threshold.

The selected display threshold is `r params$selected_threshold`, but all grid-search results are exported.

# Open and validate SQLite

```{r database}
if (!file.exists(params$database)) {
  stop("Database not found: ", params$database)
}

con <- DBI::dbConnect(RSQLite::SQLite(), params$database)

integrity <- DBI::dbGetQuery(con, "PRAGMA integrity_check")[[1]][1]
if (!identical(integrity, "ok")) stop("SQLite integrity check failed: ", integrity)

foreign_key_errors <- DBI::dbGetQuery(con, "PRAGMA foreign_key_check")
if (nrow(foreign_key_errors) > 0) stop("SQLite foreign-key check returned errors")

petals <- DBI::dbGetQuery(
  con,
  "SELECT petal, gene_count, edge_count FROM petal ORDER BY petal"
)

petal_names <- petals$petal
n_petals <- length(petal_names)
if (n_petals < 3) stop("At least three petals are required")

# The petal name itself must be a mapped gene symbol.
petal_name_map <- DBI::dbGetQuery(
  con,
  paste(
    "SELECT p.petal, gu.gene_symbol, gu.uniprot_accession",
    "FROM petal AS p",
    "LEFT JOIN gene_uniprot AS gu",
    "  ON gu.gene_symbol = p.petal",
    " AND gu.is_preferred = 1",
    "ORDER BY p.petal"
  )
)

missing_named_genes <- petal_name_map |>
  filter(is.na(uniprot_accession) | uniprot_accession == "")

if (nrow(missing_named_genes) > 0) {
  stop(
    "These petal names do not have preferred UniProt mappings: ",
    paste(missing_named_genes$petal, collapse = ", ")
  )
}

if (anyDuplicated(petal_name_map$petal)) {
  stop("At least one petal name has multiple preferred UniProt mappings")
}

petals
petal_name_map
```

# Helper functions

```{r helpers}
new_similarity_matrix <- function(names) {
  m <- matrix(NA_real_, length(names), length(names), dimnames = list(names, names))
  diag(m) <- 1
  m
}

validate_similarity <- function(m, label) {
  if (!is.matrix(m) || nrow(m) != ncol(m)) stop(label, " is not square")
  if (!identical(rownames(m), colnames(m))) stop(label, " names do not match")
  if (anyNA(m)) stop(label, " contains missing values")
  if (max(abs(m - t(m))) > 1e-10) stop(label, " is not symmetric")
  if (any(m < -1e-10 | m > 1 + 1e-10)) stop(label, " is outside [0,1]")
  invisible(TRUE)
}

matrix_to_long <- function(m, method) {
  as.data.frame(as.table(m), stringsAsFactors = FALSE) |>
    transmute(
      petal_a = as.character(Var1),
      petal_b = as.character(Var2),
      score = as.numeric(Freq),
      method = method
    ) |>
    filter(petal_a < petal_b)
}

adjusted_rand_index <- function(x, y) {
  tab <- table(x, y)
  choose2 <- function(z) z * (z - 1) / 2
  observed <- sum(choose2(tab))
  row_pairs <- sum(choose2(rowSums(tab)))
  column_pairs <- sum(choose2(colSums(tab)))
  total_pairs <- choose2(sum(tab))
  expected <- row_pairs * column_pairs / total_pairs
  maximum <- (row_pairs + column_pairs) / 2
  if (maximum == expected) return(1)
  (observed - expected) / (maximum - expected)
}

renumber_clusters <- function(membership, names_order = names(membership)) {
  membership <- membership[names_order]
  sizes <- sort(table(membership), decreasing = TRUE)
  mapping <- setNames(seq_along(sizes), names(sizes))
  result <- unname(mapping[as.character(membership)])
  setNames(as.integer(result), names_order)
}
```

# INSPIRE matrix from completed logs

```{r inspire-matrix}
if (!dir.exists(params$inspire_log_dir)) {
  stop("INSPIRE log directory not found: ", params$inspire_log_dir)
}

log_files <- list.files(params$inspire_log_dir, pattern = "\\.log$", full.names = TRUE)
if (length(log_files) == 0) stop("No INSPIRE logs found")

parse_inspire_log <- function(path) {
  text <- paste(readLines(path, warn = FALSE), collapse = "\n")
  hits <- stringr::str_match_all(
    text,
    "\\$RESULT\\$\\s+(\\S+)\\s+(\\S+)\\s+norm_score:\\s+(-?[0-9.]+(?:[eE][+-]?[0-9]+)?)"
  )[[1]]

  if (nrow(hits) == 0) return(NULL)
  hit <- hits[nrow(hits), ]
  tibble(petal_a = hit[2], petal_b = hit[3], score = as.numeric(hit[4]))
}

inspire_pairs <- bind_rows(lapply(log_files, parse_inspire_log)) |>
  filter(petal_a != petal_b) |>
  mutate(
    first = pmin(petal_a, petal_b),
    second = pmax(petal_a, petal_b)
  ) |>
  group_by(first, second) |>
  summarise(score = last(score), .groups = "drop")

inspire_similarity <- new_similarity_matrix(petal_names)

for (i in seq_len(nrow(inspire_pairs))) {
  a <- inspire_pairs$first[i]
  b <- inspire_pairs$second[i]
  if (a %in% petal_names && b %in% petal_names) {
    inspire_similarity[a, b] <- inspire_pairs$score[i]
    inspire_similarity[b, a] <- inspire_pairs$score[i]
  }
}

diag(inspire_similarity) <- 1
validate_similarity(inspire_similarity, "INSPIRE similarity")

write.csv(
  inspire_similarity,
  file.path(params$output_dir, "similarity_inspire.csv"),
  quote = FALSE
)
```

# GO comparison of petal-name genes only

Each petal contributes exactly one gene: the gene symbol equal to the petal name.

```{r go-name-only}
go_max <- DBI::dbGetQuery(
  con,
  "SELECT MAX(score) AS maximum FROM go_pair_score WHERE algorithm = ?",
  params = list(params$go_algorithm)
)$maximum[1]

if (!is.finite(go_max) || go_max <= 0) stop("Invalid GO normalization maximum")

petal_protein <- setNames(
  petal_name_map$uniprot_accession,
  petal_name_map$petal
)

go_rows <- DBI::dbGetQuery(
  con,
  "SELECT protein1, protein2, score FROM go_pair_score WHERE algorithm = ?",
  params = list(params$go_algorithm)
)

if (nrow(go_rows) == 0) stop("No GO scores found for ", params$go_algorithm)

go_lookup <- setNames(
  go_rows$score / go_max,
  paste(go_rows$protein1, go_rows$protein2, sep = "|")
)

go_similarity <- new_similarity_matrix(petal_names)

go_pair_table <- list()
row_index <- 1L

for (i in seq_along(petal_names)) {
  for (j in i:length(petal_names)) {
    petal_a <- petal_names[i]
    petal_b <- petal_names[j]

    if (petal_a == petal_b) {
      value <- 1
    } else {
      protein_a <- petal_protein[[petal_a]]
      protein_b <- petal_protein[[petal_b]]
      protein1 <- min(protein_a, protein_b)
      protein2 <- max(protein_a, protein_b)
      key <- paste(protein1, protein2, sep = "|")
      value <- unname(go_lookup[key])

      if (length(value) != 1 || is.na(value)) {
        stop("Missing GO score for petal-name genes ", petal_a, " and ", petal_b)
      }

      go_pair_table[[row_index]] <- tibble(
        petal_a = petal_a,
        petal_b = petal_b,
        gene_a = petal_a,
        gene_b = petal_b,
        protein_a = protein_a,
        protein_b = protein_b,
        normalized_go_score = value
      )
      row_index <- row_index + 1L
    }

    go_similarity[petal_a, petal_b] <- value
    go_similarity[petal_b, petal_a] <- value
  }
}

validate_similarity(go_similarity, "Petal-name GO similarity")

write.csv(
  go_similarity,
  file.path(params$output_dir, "similarity_go_petal_names.csv"),
  quote = FALSE
)

write_csv(
  bind_rows(go_pair_table),
  file.path(params$output_dir, "go_petal_name_pairs.csv")
)
```

# Pfam comparison of petal-name genes only

Each petal contributes exactly one gene. Pfam similarity is the Jaccard similarity of the two named genes' unique Pfam-domain sets.

```{r pfam-name-only}
pfam_rows <- DBI::dbGetQuery(
  con,
  "SELECT uniprot_accession, pfam_accession FROM protein_pfam ORDER BY uniprot_accession, pfam_accession"
)

pfam_by_protein <- split(pfam_rows$pfam_accession, pfam_rows$uniprot_accession)

pfam_jaccard <- function(protein_a, protein_b) {
  domains_a <- unique(pfam_by_protein[[protein_a]])
  domains_b <- unique(pfam_by_protein[[protein_b]])
  if (is.null(domains_a)) domains_a <- character()
  if (is.null(domains_b)) domains_b <- character()
  combined <- union(domains_a, domains_b)
  if (length(combined) == 0) return(0)
  length(intersect(domains_a, domains_b)) / length(combined)
}

pfam_similarity <- new_similarity_matrix(petal_names)
pfam_pair_table <- list()
row_index <- 1L

for (i in seq_along(petal_names)) {
  for (j in i:length(petal_names)) {
    petal_a <- petal_names[i]
    petal_b <- petal_names[j]

    if (petal_a == petal_b) {
      value <- 1
    } else {
      protein_a <- petal_protein[[petal_a]]
      protein_b <- petal_protein[[petal_b]]
      value <- pfam_jaccard(protein_a, protein_b)

      pfam_pair_table[[row_index]] <- tibble(
        petal_a = petal_a,
        petal_b = petal_b,
        gene_a = petal_a,
        gene_b = petal_b,
        protein_a = protein_a,
        protein_b = protein_b,
        pfam_jaccard = value
      )
      row_index <- row_index + 1L
    }

    pfam_similarity[petal_a, petal_b] <- value
    pfam_similarity[petal_b, petal_a] <- value
  }
}

validate_similarity(pfam_similarity, "Petal-name Pfam similarity")

write.csv(
  pfam_similarity,
  file.path(params$output_dir, "similarity_pfam_petal_names.csv"),
  quote = FALSE
)

write_csv(
  bind_rows(pfam_pair_table),
  file.path(params$output_dir, "pfam_petal_name_pairs.csv")
)
```

