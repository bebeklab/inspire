write_csv(
  all_scores,
  file.path(params$output_dir, "all_similarity_pairs_long.csv")
)

ggplot(all_scores, aes(score)) +
  geom_histogram(bins = 30, color = "white") +
  facet_wrap(~method, ncol = 1, scales = "free_y") +
  theme_bw() +
  labs(
    title = "Off-diagonal similarities",
