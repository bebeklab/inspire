# Matrix correlations

```{r correlations}
all_wide <- all_scores |>
  select(petal_a, petal_b, method, score) |>
  pivot_wider(names_from = method, values_from = score)

numeric_scores <- all_wide |> select(where(is.numeric))
pearson <- cor(numeric_scores, method = "pearson")
spearman <- cor(numeric_scores, method = "spearman")

write.csv(pearson,
          file.path(params$output_dir, "matrix_correlations_pearson.csv"))
write.csv(spearman,
          file.path(params$output_dir, "matrix_correlations_spearman.csv"))

pearson
spearman
```

# Metadata and disconnect

```{r metadata}
metadata <- DBI::dbGetQuery(con, "SELECT key, value FROM metadata ORDER BY key")
write_csv(metadata, file.path(params$output_dir, "database_metadata.csv"))
metadata
```

```{r disconnect}
DBI::dbDisconnect(con)
```

