# INSPIRE threshold grid search: 0.45 through 0.70

```{r threshold-grid}
thresholds <- seq(
  from = as.numeric(params$threshold_min),
  to = as.numeric(params$threshold_max),
  by = as.numeric(params$threshold_step)
)

if (length(thresholds) == 0) {
  stop("Threshold grid is empty. Check threshold parameters.")
}

inspire_long <- matrix_to_long(inspire_similarity, "INSPIRE")
complete_tree <- hclust(as.dist(1 - inspire_similarity), method = "complete")

complete_rows <- vector("list", length(thresholds))
component_rows <- vector("list", length(thresholds))
walktrap_rows <- vector("list", length(thresholds))
summary_rows <- vector("list", length(thresholds))

for (index in seq_along(thresholds)) {
  threshold <- thresholds[index]

  complete_membership <- cutree(complete_tree, h = 1 - threshold)
  complete_membership <- renumber_clusters(complete_membership, petal_names)

  retained_edges <- inspire_long |>
    filter(score > threshold) |>
    transmute(from = petal_a, to = petal_b, weight = score)

  graph <- graph_from_data_frame(
    retained_edges,
    directed = FALSE,
    vertices = tibble(name = petal_names)
  )

  graph_components <- components(graph)
  component_membership <- renumber_clusters(
    graph_components$membership,
    petal_names
  )

  if (ecount(graph) > 0) {
    walktrap_result <- cluster_walktrap(graph, weights = E(graph)$weight)
    walktrap_membership <- renumber_clusters(
      membership(walktrap_result),
      petal_names
    )
  } else {
    walktrap_membership <- setNames(seq_along(petal_names), petal_names)
  }

  complete_rows[[index]] <- tibble(
    threshold_index = index,
    threshold = threshold,
    petal = petal_names,
    cluster = unname(complete_membership[petal_names])
  )

  component_rows[[index]] <- tibble(
    threshold_index = index,
    threshold = threshold,
    petal = petal_names,
    cluster = unname(component_membership[petal_names])
  )

  walktrap_rows[[index]] <- tibble(
    threshold_index = index,
    threshold = threshold,
    petal = petal_names,
    cluster = unname(walktrap_membership[petal_names])
  )

  summary_rows[[index]] <- tibble(
    threshold_index = index,
    threshold = threshold,
    retained_edges = nrow(retained_edges),
    retained_fraction = nrow(retained_edges) / nrow(inspire_long),
    isolated_petals = sum(degree(graph) == 0),
    connected_components = graph_components$no,
    largest_component = max(graph_components$csize),
    complete_linkage_clusters = length(unique(complete_membership)),
    walktrap_clusters = length(unique(walktrap_membership)),
    complete_ari_previous = NA_real_,
    component_ari_previous = NA_real_,
    walktrap_ari_previous = NA_real_
  )
}

complete_grid <- bind_rows(complete_rows)
component_grid <- bind_rows(component_rows)
walktrap_grid <- bind_rows(walktrap_rows)
grid_summary <- bind_rows(summary_rows)

if (nrow(grid_summary) != length(thresholds)) {
  stop("Threshold grid summary was not constructed correctly")
}

if (length(thresholds) >= 2) {
  for (index in 2:length(thresholds)) {
    previous_complete <- complete_grid |>
      filter(threshold_index == index - 1L) |>
      arrange(petal)
    current_complete <- complete_grid |>
      filter(threshold_index == index) |>
      arrange(petal)

    previous_component <- component_grid |>
      filter(threshold_index == index - 1L) |>
      arrange(petal)
    current_component <- component_grid |>
      filter(threshold_index == index) |>
      arrange(petal)

    previous_walktrap <- walktrap_grid |>
      filter(threshold_index == index - 1L) |>
      arrange(petal)
    current_walktrap <- walktrap_grid |>
      filter(threshold_index == index) |>
      arrange(petal)

    if (
      nrow(previous_complete) != n_petals ||
      nrow(current_complete) != n_petals ||
      nrow(previous_component) != n_petals ||
      nrow(current_component) != n_petals ||
      nrow(previous_walktrap) != n_petals ||
      nrow(current_walktrap) != n_petals
    ) {
      stop("Incomplete assignments at threshold index ", index)
    }

    grid_summary$complete_ari_previous[index] <- adjusted_rand_index(
      previous_complete$cluster,
      current_complete$cluster
    )
    grid_summary$component_ari_previous[index] <- adjusted_rand_index(
      previous_component$cluster,
      current_component$cluster
    )
    grid_summary$walktrap_ari_previous[index] <- adjusted_rand_index(
      previous_walktrap$cluster,
      current_walktrap$cluster
    )
  }
}

write_csv(grid_summary,
          file.path(params$output_dir, "inspire_threshold_grid_summary.csv"))
write_csv(complete_grid,
          file.path(params$output_dir, "inspire_complete_linkage_grid_assignments.csv"))
write_csv(component_grid,
          file.path(params$output_dir, "inspire_component_grid_assignments.csv"))
write_csv(walktrap_grid,
          file.path(params$output_dir, "inspire_walktrap_grid_assignments.csv"))

grid_summary
```

```{r threshold-grid-plots, fig.width=12, fig.height=8}
p_edges <- ggplot(grid_summary, aes(threshold, retained_edges)) +
  geom_line() + geom_point() +
  geom_vline(xintercept = params$selected_threshold, linetype = 2) +
  theme_bw() + labs(title = "Retained INSPIRE edges", y = "Edges")

cluster_counts <- grid_summary |>
  select(threshold, complete_linkage_clusters, connected_components, walktrap_clusters) |>
  pivot_longer(-threshold, names_to = "method", values_to = "clusters")

p_clusters <- ggplot(cluster_counts, aes(threshold, clusters, color = method)) +
  geom_line() + geom_point() +
  geom_vline(xintercept = params$selected_threshold, linetype = 2) +
  theme_bw() + labs(title = "Clusters across threshold grid", y = "Clusters")

ari_long <- grid_summary |>
  select(threshold, complete_ari_previous, component_ari_previous, walktrap_ari_previous) |>
  pivot_longer(-threshold, names_to = "method", values_to = "ARI")

p_ari <- ggplot(ari_long, aes(threshold, ARI, color = method)) +
  geom_line() + geom_point() +
  geom_vline(xintercept = params$selected_threshold, linetype = 2) +
  theme_bw() +
  labs(title = "Agreement with preceding threshold", y = "Adjusted Rand index")

p_edges + p_clusters + p_ari + plot_layout(ncol = 1)
```

# Selected-threshold INSPIRE results

```{r selected-threshold}
selected_index <- which.min(abs(thresholds - params$selected_threshold))
selected_threshold <- thresholds[selected_index]

selected_complete <- complete_grid |>
  filter(threshold == selected_threshold) |>
  select(petal, complete_linkage_cluster = cluster)

selected_components <- component_grid |>
  filter(threshold == selected_threshold) |>
  select(petal, connected_component = cluster)

selected_walktrap <- walktrap_grid |>
  filter(threshold == selected_threshold) |>
  select(petal, walktrap_cluster = cluster)

selected_assignments <- selected_complete |>
  left_join(selected_components, by = "petal") |>
  left_join(selected_walktrap, by = "petal") |>
  arrange(complete_linkage_cluster, walktrap_cluster, petal)

write_csv(
  selected_assignments,
  file.path(params$output_dir, "inspire_selected_threshold_clusters.csv")
)

selected_assignments
```

```{r selected-dendrogram, fig.width=11, fig.height=6}
plot(
  complete_tree,
  main = paste0("INSPIRE complete linkage; score cutoff = ", selected_threshold),
  xlab = "",
  sub = "",
  hang = -1
)
abline(h = 1 - selected_threshold, col = "red", lty = 2, lwd = 2)
```

```{r selected-heatmap, fig.width=9, fig.height=9}
threshold_matrix <- inspire_similarity
threshold_matrix[threshold_matrix <= selected_threshold] <- 0
diag(threshold_matrix) <- 1

ordered_petals <- complete_tree$labels[complete_tree$order]
annotation <- data.frame(
  CompleteLinkage = factor(selected_complete$complete_linkage_cluster[
    match(ordered_petals, selected_complete$petal)
  ]),
  Walktrap = factor(selected_walktrap$walktrap_cluster[
    match(ordered_petals, selected_walktrap$petal)
  ]),
  row.names = ordered_petals
)

pheatmap(
  threshold_matrix[ordered_petals, ordered_petals],
  cluster_rows = FALSE,
  cluster_cols = FALSE,
  annotation_row = annotation,
  annotation_col = annotation,
  main = paste0("INSPIRE scores above ", selected_threshold),
  color = colorRampPalette(c("white", "#fee8c8", "#fdbb84", "#e34a33", "#7f0000"))(100),
  border_color = NA
)
```

```{r selected-graph, fig.width=10, fig.height=8}
selected_edges <- inspire_long |>
  filter(score > selected_threshold) |>
  transmute(from = petal_a, to = petal_b, weight = score)

selected_graph <- graph_from_data_frame(
  selected_edges,
  directed = FALSE,
  vertices = tibble(name = petal_names)
)

selected_walktrap_membership <- setNames(
  selected_walktrap$walktrap_cluster,
  selected_walktrap$petal
)

plot(
  selected_graph,
  layout = layout_with_fr(selected_graph),
  vertex.color = selected_walktrap_membership[V(selected_graph)$name],
  vertex.size = 22,
  vertex.label.cex = 0.8,
  edge.width = 1 + 5 * E(selected_graph)$weight,
  edge.color = adjustcolor("grey30", alpha.f = 0.55),
  main = paste0("Weighted INSPIRE graph; score > ", selected_threshold)
)
```

